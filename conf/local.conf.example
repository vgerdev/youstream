# Copy to conf/local.conf (git-ignored) and fill in.

db {
  url = "jdbc:postgresql://db-host:5432/youstream"
  user = "youstream"
  password = "change-me"
}

# Only needed to point at a real directory; defaults use the dev LDAP server (youstream-devldap)
# ldap {
#   url = "ldaps://ldap.example.com:636"
#   baseDn = "dc=example,dc=com"
#   bindDn = "cn=youstream,ou=system,dc=example,dc=com"
#   bindPassword = "change-me"
# }

entra {
  enabled = true
  tenantId = "00000000-0000-0000-0000-000000000000"
  clientId = "00000000-0000-0000-0000-000000000000"
  clientSecret = "change-me"
}

jwt {
  # at least 32 random bytes, e.g. openssl rand -base64 48
  secret = "change-me"
}
