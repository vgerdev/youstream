# Settings for a local k3s cluster in WSL (deploy/local/README.md). Copy to cluster.local.env (git-ignored) and run
# the platform scripts with CLUSTER_ENV=cluster.local.env (deploy/local/platform.sh does that).

PROVIDER=local
KUBE_CONTEXT=default                        # the context k3s writes to its kubeconfig
CLUSTER_NAME=

DOMAIN=youstream.localhost                  # *.localhost resolves to 127.0.0.1 in browsers, no DNS needed
SFTP_DOMAIN=localhost
ACME_EMAIL=
ACME_ISSUER=selfsigned                      # Let's Encrypt cannot reach a cluster on your machine
NAMESPACE=youstream

MEDIA_NODE_SIZE=
NFS_SIZE=30Gi
NFS_BACKING_CLASS=local-path                # k3s's local storage (a folder in the WSL file system)

# The development database server on DigitalOcean, with a database of its own (youstream_local). With DB_CLUSTER
# set, the host and CA come from doctl; otherwise fill in DB_HOST and DB_CA_FILE.
DB_CLUSTER=
DB_HOST=
DB_PORT=25060
DB_ADMIN_USER=doadmin
DB_ADMIN_DATABASE=defaultdb
DB_NAME=youstream_local
DB_USER=youstream_local
DB_CA_FILE=

GHCR_PULL_SECRET=false
