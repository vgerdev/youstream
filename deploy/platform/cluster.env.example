# Copy to cluster.env (git-ignored) and fill in. Every script in this folder reads it.
# One copy per cluster: keep e.g. cluster.doks.env / cluster.eks.env and run with CLUSTER_ENV=cluster.eks.env.

PROVIDER=doks                               # doks | eks
KUBE_CONTEXT=                               # kubectl context of the target cluster (kubectl config get-contexts)
CLUSTER_NAME=                               # doks: cluster name or ID for doctl

DOMAIN=youstream.paulsdavenport3.com
SFTP_DOMAIN=sftp.youstream.paulsdavenport3.com
ACME_EMAIL=                                 # Let's Encrypt account e-mail (expiry notices)
ACME_ISSUER=letsencrypt-staging             # letsencrypt-production once the staging certificate works
NAMESPACE=youstream

MEDIA_NODE_SIZE=s-4vcpu-8gb                 # doks droplet size of the media pool
NFS_SIZE=100Gi                              # media volume (can grow later, not shrink)
NFS_BACKING_CLASS=do-block-storage          # RWO class behind the NFS server: do-block-storage | gp3

DB_CLUSTER=                                 # doks: managed database name or ID for doctl
DB_HOST=                                    # empty on doks: read with doctl
DB_PORT=25060
DB_ADMIN_USER=doadmin
DB_ADMIN_DATABASE=defaultdb
DB_NAME=youstream_prod
DB_USER=youstream_prod
DB_CA_FILE=                                 # empty on doks: downloaded with doctl

GHCR_PULL_SECRET=false                      # true while ghcr.io/vgerdev/youstream is private
